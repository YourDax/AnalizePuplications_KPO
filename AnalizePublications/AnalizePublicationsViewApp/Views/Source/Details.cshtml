@model AnalyzePublicationsContracts.ViewModels.SourceViewModel

@{
    ViewData["Title"] = "Детали источника";
}

<h2>Детали источника</h2>

<dl class="row">
    <dt class="col-sm-3">Название:</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Тип источника:</dt>
    <dd class="col-sm-9">@Model.SourceType</dd>

    <dt class="col-sm-3">URL:</dt>
    <dd class="col-sm-9">
        @if (!string.IsNullOrEmpty(Model.Url))
        {
            <a href="@Model.Url" target="_blank">@Model.Url</a>
        }
        else
        {
            <span class="text-muted">Не указан</span>
        }
    </dd>
</dl>

<div class="mt-3">
    <a href="@Url.Action("Browse")" class="btn btn-secondary">Назад к списку</a>
</div>










