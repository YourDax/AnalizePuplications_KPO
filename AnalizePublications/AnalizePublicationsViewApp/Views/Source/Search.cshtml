@using AnalyzePublicationsDataModels.Enums
@model IEnumerable<AnalyzePublicationsContracts.ViewModels.SourceViewModel>

@{
    ViewData["Title"] = "Поиск источников";
}

<h2>Поиск источников</h2>

<form method="get" action="@Url.Action("Search")" class="mb-4">
    <div class="row">
        <div class="col-md-4">
            <label for="name" class="form-label">Название</label>
            <input type="text" class="form-control" id="name" name="name" value="@ViewBag.Name" />
        </div>
        <div class="col-md-3">
            <label for="sourceType" class="form-label">Тип источника</label>
            <select class="form-control" id="sourceType" name="sourceType">
                <option value="">Все</option>
                @foreach (var type in Enum.GetValues(typeof(SourceType)))
                {
                    var enumValue = (SourceType)type;
                    var isSelected = ViewBag.SourceType?.ToString() == ((int)enumValue).ToString();
                    <option value="@((int)enumValue)" selected="@isSelected">@enumValue</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Поиск</button>
        </div>
    </div>
    <input type="hidden" name="sortBy" value="@ViewBag.SortBy" />
    <input type="hidden" name="sortOrder" value="@ViewBag.SortOrder" />
</form>

@if (Model.Any())
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>
                    <a href="@Url.Action("Search", new { name = ViewBag.Name, sourceType = ViewBag.SourceType, sortBy = "Name", sortOrder = ViewBag.SortBy == "Name" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })" class="text-white text-decoration-none">
                        Название
                        @if (ViewBag.SortBy == "Name")
                        {
                            <span>@(ViewBag.SortOrder == "asc" ? "↑" : "↓")</span>
                        }
                    </a>
                </th>
                <th>
                    <a href="@Url.Action("Search", new { name = ViewBag.Name, sourceType = ViewBag.SourceType, sortBy = "SourceType", sortOrder = ViewBag.SortBy == "SourceType" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })" class="text-white text-decoration-none">
                        Тип источника
                        @if (ViewBag.SortBy == "SourceType")
                        {
                            <span>@(ViewBag.SortOrder == "asc" ? "↑" : "↓")</span>
                        }
                    </a>
                </th>
                <th>
                    <a href="@Url.Action("Search", new { name = ViewBag.Name, sourceType = ViewBag.SourceType, sortBy = "Url", sortOrder = ViewBag.SortBy == "Url" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })" class="text-white text-decoration-none">
                        URL
                        @if (ViewBag.SortBy == "Url")
                        {
                            <span>@(ViewBag.SortOrder == "asc" ? "↑" : "↓")</span>
                        }
                    </a>
                </th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var source in Model)
            {
                <tr>
                    <td>@source.Name</td>
                    <td>@source.SourceType</td>
                    <td>
                        @if (!string.IsNullOrEmpty(source.Url))
                        {
                            <a href="@source.Url" target="_blank">@source.Url</a>
                        }
                        else
                        {
                            <span class="text-muted">Не указан</span>
                        }
                    </td>
                    <td>
                        <a href="@Url.Action("Details", new { id = source.Id })" class="btn btn-sm btn-info">Детали</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p class="text-muted">Найдено источников: @Model.Count()</p>
}
else
{
    <div class="alert alert-info">Источники не найдены</div>
}










