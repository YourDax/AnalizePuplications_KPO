@model IEnumerable<AnalyzePublicationsContracts.ViewModels.SourceViewModel>

@{
    ViewData["Title"] = "Просмотр источников";
}

<h2>Просмотр источников</h2>

<div class="mb-3">
    <a href="@Url.Action("Search")" class="btn btn-primary">Поиск и фильтры</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>
                <a href="@Url.Action("Browse", new { sortBy = "Name", sortOrder = ViewBag.SortBy == "Name" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })" class="text-white text-decoration-none">
                    Название
                    @if (ViewBag.SortBy == "Name")
                    {
                        <span>@(ViewBag.SortOrder == "asc" ? "↑" : "↓")</span>
                    }
                </a>
            </th>
            <th>
                <a href="@Url.Action("Browse", new { sortBy = "SourceType", sortOrder = ViewBag.SortBy == "SourceType" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })" class="text-white text-decoration-none">
                    Тип источника
                    @if (ViewBag.SortBy == "SourceType")
                    {
                        <span>@(ViewBag.SortOrder == "asc" ? "↑" : "↓")</span>
                    }
                </a>
            </th>
            <th>
                <a href="@Url.Action("Browse", new { sortBy = "Url", sortOrder = ViewBag.SortBy == "Url" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })" class="text-white text-decoration-none">
                    URL
                    @if (ViewBag.SortBy == "Url")
                    {
                        <span>@(ViewBag.SortOrder == "asc" ? "↑" : "↓")</span>
                    }
                </a>
            </th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var source in Model)
        {
            <tr>
                <td>@source.Name</td>
                <td>@source.SourceType</td>
                <td>
                    @if (!string.IsNullOrEmpty(source.Url))
                    {
                        <a href="@source.Url" target="_blank">@source.Url</a>
                    }
                    else
                    {
                        <span class="text-muted">Не указан</span>
                    }
                </td>
                <td>
                    <a href="@Url.Action("Details", new { id = source.Id })" class="btn btn-sm btn-info">Детали</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<p class="text-muted">Всего источников: @Model.Count()</p>










