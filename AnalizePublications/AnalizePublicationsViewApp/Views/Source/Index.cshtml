@model IEnumerable<AnalyzePublicationsContracts.ViewModels.SourceViewModel>

@{
    ViewData["Title"] = "Управление источниками";
}

<h2>Управление источниками</h2>

<div class="mb-3">
    <a class="btn btn-primary" href="@Url.Action("Create")">Создать источник</a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Название</th>
            <th>Тип</th>
            <th>URL</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var source in Model)
        {
            <tr>
                <td>@source.Id</td>
                <td>@source.Name</td>
                <td>@source.SourceType</td>
                <td>
                    @if (!string.IsNullOrEmpty(source.Url))
                    {
                        <a href="@source.Url" target="_blank">@source.Url</a>
                    }
                    else
                    {
                        <span class="text-muted">Не указан</span>
                    }
                </td>
                <td>
                    <a href="@Url.Action("Edit", new { id = source.Id })" class="btn btn-sm btn-warning">Редактировать</a>
                    <a href="@Url.Action("Delete", new { id = source.Id })" class="btn btn-sm btn-danger">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<p class="text-muted">Всего источников: @Model.Count()</p>
