@model AnalyzePublicationsContracts.BindingModels.SourceBindingModel
@{
    ViewData["Title"] = "Создать источник";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="Name" class="form-label">Название *</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="SourceType" class="form-label">Тип источника *</label>
        <select asp-for="SourceType" class="form-control">
            @foreach (var type in Enum.GetValues(typeof(AnalyzePublicationsDataModels.Enums.SourceType)))
            {
                var enumValue = (AnalyzePublicationsDataModels.Enums.SourceType)type;
                <option value="@((int)enumValue)">
                    @enumValue
                </option>
            }
        </select>
        <span asp-validation-for="SourceType" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Url" class="form-label">URL</label>
        <input asp-for="Url" type="url" class="form-control" />
        <span asp-validation-for="Url" class="text-danger"></span>
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-success">Создать</button>
        <a href="@Url.Action("Index")" class="btn btn-secondary">Отмена</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
