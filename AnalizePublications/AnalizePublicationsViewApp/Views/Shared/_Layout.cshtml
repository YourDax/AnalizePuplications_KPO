<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AnalizePublicationsViewApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AnalizePublicationsViewApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">AnalizePublicationsViewApp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="viewDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Просмотр и поиск
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="viewDropdown">
                                <li><a class="dropdown-item" asp-controller="Author" asp-action="Browse">Авторы</a></li>
                                <li><a class="dropdown-item" asp-controller="Publication" asp-action="Browse">Публикации</a></li>
                                <li><a class="dropdown-item" asp-controller="Source" asp-action="Browse">Источники</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Author" asp-action="Search">Поиск авторов</a></li>
                                <li><a class="dropdown-item" asp-controller="Publication" asp-action="Search">Поиск публикаций</a></li>
                                <li><a class="dropdown-item" asp-controller="Source" asp-action="Search">Поиск источников</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="editDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Редактирование
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="editDropdown">
                                <li><a class="dropdown-item" asp-controller="Author" asp-action="Index">Авторы</a></li>
                                <li><a class="dropdown-item" asp-controller="Publication" asp-action="Index">Публикации</a></li>
                                <li><a class="dropdown-item" asp-controller="Source" asp-action="Index">Источники</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - AnalizePublicationsViewApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    
    <!-- Незаметная кнопка для инициализации тестовых данных -->
    <button type="button" id="testDataBtn" class="btn btn-sm btn-outline-secondary" style="position: fixed; bottom: 5px; right: 5px; z-index: 1000; opacity: 0.2; font-size: 9px; padding: 1px 3px; border: none; background: transparent;" title="Инициализировать тестовые данные" onmouseover="this.style.opacity='0.5'" onmouseout="this.style.opacity='0.2'">
        ⚙
    </button>

    <!-- Модальное окно для выбора действия -->
    <div class="modal fade" id="testDataModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Инициализация тестовых данных</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p id="modalMessage">Выберите действие:</p>
                    <form id="testDataForm" method="post" action="@Url.Action("Initialize", "TestData")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="action" id="actionInput" value="create" />
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-primary" onclick="setActionAndSubmit('create')" id="createBtn">
                                Создать тестовые данные
                            </button>
                            <button type="button" class="btn btn-danger" onclick="setActionAndSubmit('clear')" id="clearBtn">
                                Удалить все данные из базы данных
                            </button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                Отмена
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var testDataBtn = document.getElementById('testDataBtn');
            if (testDataBtn) {
                testDataBtn.addEventListener('click', function() {
                    // Просто показываем модальное окно - все кнопки всегда видны
                    var modalElement = document.getElementById('testDataModal');
                    if (modalElement) {
                        var modal = new bootstrap.Modal(modalElement);
                        modal.show();
                    }
                });
            }

            window.setActionAndSubmit = function(action) {
                var actionInput = document.getElementById('actionInput');
                var form = document.getElementById('testDataForm');
                if (actionInput && form) {
                    actionInput.value = action;
                    form.submit();
                }
            };
        });
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
