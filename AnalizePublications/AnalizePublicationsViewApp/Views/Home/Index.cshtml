@{
    ViewData["Title"] = "Главная";
}

<div class="text-center mt-5 mb-4">
    <h1 class="display-4">Система анализа публикаций</h1>
    <p class="lead">Используйте карточки ниже, чтобы просматривать и искать авторов, публикации и источники.</p>
</div>

<div class="container">
    <div class="row justify-content-center">

        <!-- Authors -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Авторы</h5>
                    <p class="card-text">Просматривайте список авторов, их метрики и детальную информацию.</p>
                    <div class="mt-auto">
                        <a href="/Author/Browse" class="btn btn-primary">Просмотр</a>
                        <a href="/Author/Search" class="btn btn-outline-primary">Поиск</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Publications -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Публикации</h5>
                    <p class="card-text">Просматривайте список публикаций, их детали и информацию об авторах.</p>
                    <div class="mt-auto">
                        <a href="/Publication/Browse" class="btn btn-success">Просмотр</a>
                        <a href="/Publication/Search" class="btn btn-outline-success">Поиск</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sources -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Источники</h5>
                    <p class="card-text">Просматривайте список источников публикаций и их детальную информацию.</p>
                    <div class="mt-auto">
                        <a href="/Source/Browse" class="btn btn-warning">Просмотр</a>
                        <a href="/Source/Search" class="btn btn-outline-warning">Поиск</a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" style="position: fixed; top: 70px; right: 20px; z-index: 1050; min-width: 300px;">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["InfoMessage"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert" style="position: fixed; top: 70px; right: 20px; z-index: 1050; min-width: 300px;">
        @TempData["InfoMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["WarningMessage"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert" style="position: fixed; top: 70px; right: 20px; z-index: 1050; min-width: 300px;">
        @TempData["WarningMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert" style="position: fixed; top: 70px; right: 20px; z-index: 1050; min-width: 300px;">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}