@{
    ViewData["Title"] = "Главная";
}

<div class="text-center mt-5 mb-4">
    <h1 class="display-4">Система анализа публикаций</h1>
    <p class="lead">Используйте меню ниже, чтобы управлять авторами, публикациями и источниками.</p>
</div>

<div class="container">
    <div class="row justify-content-center">

        <!-- Authors -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Авторы</h5>
                    <p class="card-text">Создавайте, редактируйте и удаляйте авторов публикаций.</p>
                    <a href="/Author/Index" class="btn btn-primary mt-auto">Перейти</a>
                </div>
            </div>
        </div>

        <!-- Publications -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Публикации</h5>
                    <p class="card-text">Просматривайте, создавайте и редактируйте публикации, связывая их с авторами и источниками.</p>
                    <a href="/Publication/Index" class="btn btn-success mt-auto">Перейти</a>
                </div>
            </div>
        </div>

        <!-- Sources -->
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Источники</h5>
                    <p class="card-text">Управляйте источниками публикаций, добавляйте новые ссылки и редактируйте существующие.</p>
                    <a href="/Source/Index" class="btn btn-warning mt-auto">Перейти</a>
                </div>
            </div>
        </div>

    </div>
</div>
