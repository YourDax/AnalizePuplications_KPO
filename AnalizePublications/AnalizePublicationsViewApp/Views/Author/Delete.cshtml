@model AnalyzePublicationsContracts.ViewModels.AuthorViewModel

<h2>Удалить автора</h2>

<p>Вы уверены, что хотите удалить "@Model.FullName"?</p>

<form method="post" action="/Author/DeleteConfirmed/@Model.Id">
    <button class="btn btn-danger">Удалить</button>
    <a href="/Author/Index" class="btn btn-secondary">Отмена</a>
</form>
