@model IEnumerable<AnalyzePublicationsContracts.ViewModels.AuthorViewModel>

@{
    ViewData["Title"] = "Управление авторами";
}

<h2>Управление авторами</h2>

<div class="mb-3">
    <a class="btn btn-primary" href="@Url.Action("Create")">Создать автора</a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Полное имя</th>
            <th>Организация</th>
            <th>Email</th>
            <th>Публикаций</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var author in Model)
        {
            <tr>
                <td>@author.Id</td>
                <td>@author.FullName</td>
                <td>@author.Affiliation</td>
                <td>@author.Email</td>
                <td>@author.PublicationsCount</td>
                <td>
                    <a href="@Url.Action("Edit", new { id = author.Id })" class="btn btn-sm btn-warning">Редактировать</a>
                    <a href="@Url.Action("Delete", new { id = author.Id })" class="btn btn-sm btn-danger">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<p class="text-muted">Всего авторов: @Model.Count()</p>
