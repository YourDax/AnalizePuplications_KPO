@model IEnumerable<AnalyzePublicationsContracts.ViewModels.AuthorViewModel>

@{
    ViewData["Title"] = "Просмотр авторов";
}

<h2>Просмотр авторов</h2>

<div class="mb-3">
    <a href="@Url.Action("Search")" class="btn btn-primary">Поиск и фильтры</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>
                <a href="@Url.Action("Browse", new { sortBy = "FullName", sortOrder = ViewBag.SortBy == "FullName" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })" class="text-white text-decoration-none">
                    Полное имя
                    @if (ViewBag.SortBy == "FullName")
                    {
                        <span>@(ViewBag.SortOrder == "asc" ? "↑" : "↓")</span>
                    }
                </a>
            </th>
            <th>
                <a href="@Url.Action("Browse", new { sortBy = "Affiliation", sortOrder = ViewBag.SortBy == "Affiliation" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })" class="text-white text-decoration-none">
                    Организация
                    @if (ViewBag.SortBy == "Affiliation")
                    {
                        <span>@(ViewBag.SortOrder == "asc" ? "↑" : "↓")</span>
                    }
                </a>
            </th>
            <th>
                <a href="@Url.Action("Browse", new { sortBy = "Email", sortOrder = ViewBag.SortBy == "Email" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })" class="text-white text-decoration-none">
                    Email
                    @if (ViewBag.SortBy == "Email")
                    {
                        <span>@(ViewBag.SortOrder == "asc" ? "↑" : "↓")</span>
                    }
                </a>
            </th>
            <th>
                <a href="@Url.Action("Browse", new { sortBy = "PublicationsCount", sortOrder = ViewBag.SortBy == "PublicationsCount" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })" class="text-white text-decoration-none">
                    Публикаций
                    @if (ViewBag.SortBy == "PublicationsCount")
                    {
                        <span>@(ViewBag.SortOrder == "asc" ? "↑" : "↓")</span>
                    }
                </a>
            </th>
            <th>
                <a href="@Url.Action("Browse", new { sortBy = "CoauthorsCount", sortOrder = ViewBag.SortBy == "CoauthorsCount" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })" class="text-white text-decoration-none">
                    Соавторов
                    @if (ViewBag.SortBy == "CoauthorsCount")
                    {
                        <span>@(ViewBag.SortOrder == "asc" ? "↑" : "↓")</span>
                    }
                </a>
            </th>
            <th>
                <a href="@Url.Action("Browse", new { sortBy = "CitationCount", sortOrder = ViewBag.SortBy == "CitationCount" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })" class="text-white text-decoration-none">
                    Цитирований
                    @if (ViewBag.SortBy == "CitationCount")
                    {
                        <span>@(ViewBag.SortOrder == "asc" ? "↑" : "↓")</span>
                    }
                </a>
            </th>
            <th>
                <a href="@Url.Action("Browse", new { sortBy = "HIndex", sortOrder = ViewBag.SortBy == "HIndex" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })" class="text-white text-decoration-none">
                    H-индекс
                    @if (ViewBag.SortBy == "HIndex")
                    {
                        <span>@(ViewBag.SortOrder == "asc" ? "↑" : "↓")</span>
                    }
                </a>
            </th>
            <th>
                <a href="@Url.Action("Browse", new { sortBy = "AveragePages", sortOrder = ViewBag.SortBy == "AveragePages" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })" class="text-white text-decoration-none">
                    Сред. страниц
                    @if (ViewBag.SortBy == "AveragePages")
                    {
                        <span>@(ViewBag.SortOrder == "asc" ? "↑" : "↓")</span>
                    }
                </a>
            </th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var author in Model)
        {
            <tr>
                <td>@author.FullName</td>
                <td>@author.Affiliation</td>
                <td>@author.Email</td>
                <td>@author.PublicationsCount</td>
                <td>@author.CoauthorsCount</td>
                <td>@author.CitationCount</td>
                <td>@author.HIndex</td>
                <td>@author.AveragePages.ToString("F2")</td>
                <td>
                    <a href="@Url.Action("Details", new { id = author.Id })" class="btn btn-sm btn-info">Детали</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<p class="text-muted">Всего авторов: @Model.Count()</p>












