@using AnalyzePublicationsDataModels.Enums
@model AnalyzePublicationsContracts.BindingModels.PublicationBindingModel

@{
    ViewData["Title"] = "Добавить публикацию";
}

<h2>Добавить публикацию</h2>

<form asp-action="Create" method="post">

    <div class="form-group">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="PublicationDate">Дата публикации</label>
        <input asp-for="PublicationDate" type="date" class="form-control" />
        <span asp-validation-for="PublicationDate" class="text-danger"></span>
    </div>

    <!-- ENUM PublicationType -->
    <div class="form-group">
        <label asp-for="PublicationType">Тип публикации</label>
        <select asp-for="PublicationType" class="form-control">
            @foreach (var type in Enum.GetValues(typeof(PublicationType)))
            {
                var enumValue = (PublicationType)type;

                <option value="@((int)enumValue)">
                    @enumValue
                </option>
            }
        </select>
    </div>

    <div class="form-group">
        <label asp-for="SourceId">Источник</label>
        <select asp-for="SourceId" asp-items="ViewBag.Sources" class="form-control"></select>
        <span asp-validation-for="SourceId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Doi">DOI</label>
        <input asp-for="Doi" class="form-control" />
        <span asp-validation-for="Doi" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Pages">Количество страниц</label>
        <input asp-for="Pages" type="number" class="form-control" />
        <span asp-validation-for="Pages" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Abstract">Аннотация</label>
        <textarea asp-for="Abstract" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Abstract" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Keywords">Ключевые слова</label>
        <input asp-for="Keywords" class="form-control" />
        <span asp-validation-for="Keywords" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CitationCount">Количество цитирований</label>
        <input asp-for="CitationCount" type="number" class="form-control" />
        <span asp-validation-for="CitationCount" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Авторы</label>
        <div id="authors-container">
            <div class="author-item mb-2">
                <select name="Authors[0].AuthorId" asp-items="ViewBag.Authors" class="form-control d-inline-block" style="width: 200px;">
                    <option value="">Выберите автора</option>
                </select>
                <input type="text" name="Authors[0].AuthorContribution" placeholder="Вклад автора (опционально)" 
                       class="form-control d-inline-block" style="width: 300px; margin-left: 10px;" />
                <button type="button" class="btn btn-sm btn-danger remove-author" style="margin-left: 10px;">Удалить</button>
            </div>
        </div>
        <button type="button" id="add-author" class="btn btn-sm btn-secondary mt-2">Добавить автора</button>
    </div>

    <button type="submit" class="btn btn-primary">Создать</button>
</form>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        let authorIndex = 1;
        
        document.getElementById('add-author').addEventListener('click', function() {
            const container = document.getElementById('authors-container');
            const newAuthor = document.createElement('div');
            newAuthor.className = 'author-item mb-2';
            newAuthor.innerHTML = `
                <select name="Authors[${authorIndex}].AuthorId" asp-items="ViewBag.Authors" class="form-control d-inline-block" style="width: 200px;">
                    <option value="">Выберите автора</option>
                    @foreach (var author in ViewBag.Authors as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                    {
                        <option value="@author.Value">@author.Text</option>
                    }
                </select>
                <input type="text" name="Authors[${authorIndex}].AuthorContribution" placeholder="Вклад автора (опционально)" 
                       class="form-control d-inline-block" style="width: 300px; margin-left: 10px;" />
                <button type="button" class="btn btn-sm btn-danger remove-author" style="margin-left: 10px;">Удалить</button>
            `;
            container.appendChild(newAuthor);
            authorIndex++;
        });
        
        document.getElementById('authors-container').addEventListener('click', function(e) {
            if (e.target.classList.contains('remove-author')) {
                const authorItems = document.querySelectorAll('.author-item');
                if (authorItems.length > 1) {
                    e.target.closest('.author-item').remove();
                } else {
                    alert('Публикация должна иметь хотя бы одного автора');
                }
            }
        });
    });
</script>
