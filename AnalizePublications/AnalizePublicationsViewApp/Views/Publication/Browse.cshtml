@model IEnumerable<AnalyzePublicationsContracts.ViewModels.PublicationViewModel>

@{
    ViewData["Title"] = "Просмотр публикаций";
}

<h2>Просмотр публикаций</h2>

<div class="mb-3">
    <a href="@Url.Action("Search")" class="btn btn-primary">Поиск и фильтры</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>
                <a href="@Url.Action("Browse", new { sortBy = "Title", sortOrder = ViewBag.SortBy == "Title" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })" class="text-white text-decoration-none">
                    Название
                    @if (ViewBag.SortBy == "Title")
                    {
                        <span>@(ViewBag.SortOrder == "asc" ? "↑" : "↓")</span>
                    }
                </a>
            </th>
            <th>
                <a href="@Url.Action("Browse", new { sortBy = "PublicationDate", sortOrder = ViewBag.SortBy == "PublicationDate" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })" class="text-white text-decoration-none">
                    Дата публикации
                    @if (ViewBag.SortBy == "PublicationDate")
                    {
                        <span>@(ViewBag.SortOrder == "asc" ? "↑" : "↓")</span>
                    }
                </a>
            </th>
            <th>
                <a href="@Url.Action("Browse", new { sortBy = "PublicationType", sortOrder = ViewBag.SortBy == "PublicationType" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })" class="text-white text-decoration-none">
                    Тип
                    @if (ViewBag.SortBy == "PublicationType")
                    {
                        <span>@(ViewBag.SortOrder == "asc" ? "↑" : "↓")</span>
                    }
                </a>
            </th>
            <th>
                <a href="@Url.Action("Browse", new { sortBy = "Pages", sortOrder = ViewBag.SortBy == "Pages" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })" class="text-white text-decoration-none">
                    Страниц
                    @if (ViewBag.SortBy == "Pages")
                    {
                        <span>@(ViewBag.SortOrder == "asc" ? "↑" : "↓")</span>
                    }
                </a>
            </th>
            <th>
                <a href="@Url.Action("Browse", new { sortBy = "CitationCount", sortOrder = ViewBag.SortBy == "CitationCount" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })" class="text-white text-decoration-none">
                    Цитирования
                    @if (ViewBag.SortBy == "CitationCount")
                    {
                        <span>@(ViewBag.SortOrder == "asc" ? "↑" : "↓")</span>
                    }
                </a>
            </th>
            <th>Авторы</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var pub in Model)
        {
            <tr>
                <td>@pub.Title</td>
                <td>@(pub.PublicationDate?.ToString("dd.MM.yyyy") ?? "Не указана")</td>
                <td>@pub.PublicationType</td>
                <td>@(pub.Pages?.ToString() ?? "-")</td>
                <td>@pub.CitationCount</td>
                <td>@string.Join(", ", pub.Authors?.Select(a => a.AuthorName) ?? new List<string>())</td>
                <td>
                    <a href="@Url.Action("Details", new { id = pub.Id })" class="btn btn-sm btn-info">Детали</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<p class="text-muted">Всего публикаций: @Model.Count()</p>







