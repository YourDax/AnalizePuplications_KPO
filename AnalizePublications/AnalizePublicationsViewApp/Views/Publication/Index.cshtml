@model IEnumerable<AnalyzePublicationsContracts.ViewModels.PublicationViewModel>

<h2>Публикации</h2>

<a class="btn btn-primary" href="/Publication/Create">Создать публикацию</a>

<table class="table mt-3">
    <thead>
        <tr>
            <th>Id</th>
            <th>Название</th>
            <th>Дата публикации</th>
            <th>Тип</th>
            <th>Источник</th>
            <th>DOI</th>
            <th>Страниц</th>
            <th>Цитирования</th>
            <th>Авторы</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.Title</td>
                <td>@(p.PublicationDate?.ToString("dd.MM.yyyy") ?? "Не указана")</td>
                <td>@p.PublicationType</td>
                <td>@p.SourceId</td>
                <td>@p.Doi</td>
                <td>@(p.Pages?.ToString() ?? "-")</td>
                <td>@p.CitationCount</td>
                <td>@string.Join(", ", p.Authors?.Select(a => a.AuthorName) ?? new List<string>())</td>
                <td>
                    <a href="/Publication/Edit/@p.Id">Редактировать</a> |
                    <a href="/Publication/Delete/@p.Id">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>
