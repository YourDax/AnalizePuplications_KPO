@model IEnumerable<AnalyzePublicationsContracts.ViewModels.PublicationViewModel>

@{
    ViewData["Title"] = "Управление публикациями";
}

<h2>Управление публикациями</h2>

<div class="mb-3">
    <a class="btn btn-primary" href="@Url.Action("Create")">Создать публикацию</a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Название</th>
            <th>Дата публикации</th>
            <th>Тип</th>
            <th>Источник ID</th>
            <th>Страниц</th>
            <th>Цитирования</th>
            <th>Авторы</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var pub in Model)
        {
            <tr>
                <td>@pub.Id</td>
                <td>@pub.Title</td>
                <td>@(pub.PublicationDate?.ToString("dd.MM.yyyy") ?? "Не указана")</td>
                <td>@pub.PublicationType</td>
                <td>@pub.SourceId</td>
                <td>@(pub.Pages?.ToString() ?? "-")</td>
                <td>@pub.CitationCount</td>
                <td>@string.Join(", ", pub.Authors?.Select(a => a.AuthorName) ?? new List<string>())</td>
                <td>
                    <a href="@Url.Action("Edit", new { id = pub.Id })" class="btn btn-sm btn-warning">Редактировать</a>
                    <a href="@Url.Action("Delete", new { id = pub.Id })" class="btn btn-sm btn-danger">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<p class="text-muted">Всего публикаций: @Model.Count()</p>
