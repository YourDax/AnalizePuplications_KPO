@model IEnumerable<AnalyzePublicationsContracts.ViewModels.PublicationViewModel>

@{
    ViewData["Title"] = "Поиск публикаций";
}

<h2>Поиск публикаций</h2>

<form method="get" action="@Url.Action("Search")" class="mb-4">
    <div class="row">
        <div class="col-md-3">
            <label for="title" class="form-label">Название</label>
            <input type="text" class="form-control" id="title" name="title" value="@ViewBag.Title" />
        </div>
        <div class="col-md-2">
            <label for="dateFrom" class="form-label">Дата от</label>
            <input type="date" class="form-control" id="dateFrom" name="dateFrom" value="@(ViewBag.DateFrom?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-2">
            <label for="dateTo" class="form-label">Дата до</label>
            <input type="date" class="form-control" id="dateTo" name="dateTo" value="@(ViewBag.DateTo?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-2">
            <label for="sourceId" class="form-label">Источник</label>
            <select class="form-control" id="sourceId" name="sourceId">
                <option value="">Все</option>
                @if (ViewBag.Sources != null)
                {
                    @foreach (var source in (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Sources)
                    {
                        <option value="@source.Value" selected="@(ViewBag.SourceId?.ToString() == source.Value)">@source.Text</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Поиск</button>
        </div>
    </div>
    <input type="hidden" name="sortBy" value="@ViewBag.SortBy" />
    <input type="hidden" name="sortOrder" value="@ViewBag.SortOrder" />
</form>

@if (Model.Any())
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>
                    <a href="@Url.Action("Search", new { title = ViewBag.Title, dateFrom = ViewBag.DateFrom, dateTo = ViewBag.DateTo, sourceId = ViewBag.SourceId, sortBy = "Title", sortOrder = ViewBag.SortBy == "Title" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })" class="text-white text-decoration-none">
                        Название
                        @if (ViewBag.SortBy == "Title")
                        {
                            <span>@(ViewBag.SortOrder == "asc" ? "↑" : "↓")</span>
                        }
                    </a>
                </th>
                <th>
                    <a href="@Url.Action("Search", new { title = ViewBag.Title, dateFrom = ViewBag.DateFrom, dateTo = ViewBag.DateTo, sourceId = ViewBag.SourceId, sortBy = "PublicationDate", sortOrder = ViewBag.SortBy == "PublicationDate" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })" class="text-white text-decoration-none">
                        Дата публикации
                        @if (ViewBag.SortBy == "PublicationDate")
                        {
                            <span>@(ViewBag.SortOrder == "asc" ? "↑" : "↓")</span>
                        }
                    </a>
                </th>
                <th>
                    <a href="@Url.Action("Search", new { title = ViewBag.Title, dateFrom = ViewBag.DateFrom, dateTo = ViewBag.DateTo, sourceId = ViewBag.SourceId, sortBy = "PublicationType", sortOrder = ViewBag.SortBy == "PublicationType" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })" class="text-white text-decoration-none">
                        Тип
                        @if (ViewBag.SortBy == "PublicationType")
                        {
                            <span>@(ViewBag.SortOrder == "asc" ? "↑" : "↓")</span>
                        }
                    </a>
                </th>
                <th>
                    <a href="@Url.Action("Search", new { title = ViewBag.Title, dateFrom = ViewBag.DateFrom, dateTo = ViewBag.DateTo, sourceId = ViewBag.SourceId, sortBy = "Pages", sortOrder = ViewBag.SortBy == "Pages" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })" class="text-white text-decoration-none">
                        Страниц
                        @if (ViewBag.SortBy == "Pages")
                        {
                            <span>@(ViewBag.SortOrder == "asc" ? "↑" : "↓")</span>
                        }
                    </a>
                </th>
                <th>
                    <a href="@Url.Action("Search", new { title = ViewBag.Title, dateFrom = ViewBag.DateFrom, dateTo = ViewBag.DateTo, sourceId = ViewBag.SourceId, sortBy = "CitationCount", sortOrder = ViewBag.SortBy == "CitationCount" && ViewBag.SortOrder == "asc" ? "desc" : "asc" })" class="text-white text-decoration-none">
                        Цитирования
                        @if (ViewBag.SortBy == "CitationCount")
                        {
                            <span>@(ViewBag.SortOrder == "asc" ? "↑" : "↓")</span>
                        }
                    </a>
                </th>
                <th>Авторы</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pub in Model)
            {
                <tr>
                    <td>@pub.Title</td>
                    <td>@(pub.PublicationDate?.ToString("dd.MM.yyyy") ?? "Не указана")</td>
                    <td>@pub.PublicationType</td>
                    <td>@(pub.Pages?.ToString() ?? "-")</td>
                    <td>@pub.CitationCount</td>
                    <td>@string.Join(", ", pub.Authors?.Select(a => a.AuthorName) ?? new List<string>())</td>
                    <td>
                        <a href="@Url.Action("Details", new { id = pub.Id })" class="btn btn-sm btn-info">Детали</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <p class="text-muted">Найдено публикаций: @Model.Count()</p>
}
else
{
    <div class="alert alert-info">Публикации не найдены</div>
}







